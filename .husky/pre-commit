# バージョン同期
echo "🔄 Syncing version between package.json and manifest.json..."
manifest=public/manifest.json
before=$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync("public/manifest.json","utf8")).version))')
node scripts/sync-version.js
after=$(node -e 'process.stdout.write(String(JSON.parse(require("fs").readFileSync("public/manifest.json","utf8")).version))')

# バージョンが変わったときだけステージする
if [ "$before" != "$after" ]; then
  git add "$manifest"
fi

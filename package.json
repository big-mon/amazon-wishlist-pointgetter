{
  "name": "amazon-wishlist-pointgetter",
  "description": "Google Chrome Extension for Amazon.co.jp",
  "version": "1.6.0",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/big-mon/amazon-wishlist-pointgetter",
  "author": "BIG-MON <> (https://github.com/big-mon)",
  "scripts": {
    "build": "node scripts/build-production.js",
    "dev": "node scripts/build-production.js --development",
    "watch": "node scripts/build-production.js --watch",
    "clean": "rm -rf dist",
    "test": "node tests/util.test.js && node tests/wishlist.test.js && node tests/build.test.js && node tests/package-extension.test.js",
    "type-check": "tsc --noEmit",
    "deploy-chrome": "node scripts/upload-chrome-web-store.js",
    "zip": "node scripts/package-extension.js",
    "sync-version": "node scripts/sync-version.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
